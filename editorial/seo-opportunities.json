    "require_explicit_approval_before_publishing": true,
    "require_related_releases_section": true,
    "do_not_repeat_without_material_update": true,
    "store_source_time_and_timezone": true
  },
  "record_fields": [
    "id",
    "title_en",
    "status",
    "first_detected_at",
    "announcement_at",
    "announcement_timezone",
    "official_source_url",
    "official_cover_url",
    "official_trailer_url",
    "score",
    "score_breakdown",
    "seo_rationale",
    "keywords",
    "competition",
    "action",
    "existing_article_url",
    "last_substantive_update_at",
    "approval_at",
    "publication_url"
  ]
}
