{
  "schema_version": 1,
  "site": "https://aninextup.com",
  "purpose": "Editorial SEO opportunity approval queue; never auto-publish",
  "updated_at": "2026-10-13",
  "opportunities": [],
  "statuses": [
    "PENDING_APPROVAL",
    "APPROVED",
    "PUBLISHED",
    "DISCARDED"
  ],
  "scoring": {
    "recency": 30,
    "search_intent": 25,
    "competition_gap": 20,
    "editorial_value": 15,
    "official_verification": 10
