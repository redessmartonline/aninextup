{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aninextup",
  "compatibility_date": "2026-10-09",
  "main": "src/contact-worker.js",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/contact",
      "/api/newsletter/*",
      "/api/comments"
    ],
    "directory": "./"
  },
  "previews": {},
  "triggers": {
    "crons": [
      "0 12 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "aninextup-newsletter",
      "database_id": "4b800ca2-2f01-45a6-9240-70b1eda5b4d8"
    }
  ],
  "vars": {
    "CONTACT_FROM_EMAIL": "AniNextUp <newsletter@aninextup.com>"
  }
}
